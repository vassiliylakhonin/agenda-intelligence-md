{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/middle-corridor-deal-risk-response.schema.json",
  "title": "MiddleCorridorDealRiskResponse",
  "description": "Product-grade structured response contract for Kazakhstan / Middle Corridor deal-risk evidence triage. This schema supports source-coverage gaps, escalation routing, watch-next indicators, and human-review requirements. It does not provide legal advice, sanctions advice, compliance advice, financial advice, investment advice, insurance advice, trading advice, live retrieval, or factual-truth verification.",
  "x-schema-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "triage_recommendation",
    "risk_signal",
    "decision_readiness_score",
    "decision_readiness_label",
    "supplied_sources",
    "minimum_sources_before_go",
    "evidence_gaps",
    "watch_next",
    "human_review_required",
    "not_advice_notice"
  ],
  "properties": {
    "triage_recommendation": {
      "type": "string",
      "enum": [
        "not_decision_ready",
        "escalate_before_signature",
        "escalate_before_shipment",
        "ready_for_human_review",
        "insufficient_information"
      ]
    },
    "risk_signal": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "medium_high",
        "high",
        "unknown"
      ]
    },
    "decision_readiness_score": {
      "description": "Heuristic 0-100 score for evidence-pack readiness for human review. This is not approval, clearance, legal advice, sanctions advice, compliance advice, financial advice, investment advice, insurance advice, or trading advice.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "decision_readiness_label": {
      "type": "string",
      "enum": [
        "insufficient_information",
        "not_decision_ready",
        "partial",
        "review_ready"
      ]
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "cargo": {
      "type": "string",
      "minLength": 1
    },
    "shipment_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "enum": [
            "USD",
            "EUR",
            "GBP",
            "KZT",
            "CNY",
            "TRY",
            "AED",
            "other"
          ]
        }
      }
    },
    "counterparties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/counterparty"
      }
    },
    "supplied_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_type"
      }
    },
    "minimum_sources_before_go": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_type"
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "top_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exposure_layers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Risk picture decomposed into the two layers a practitioner separates: home-jurisdiction legal / documentation posture (not assessed by this product) versus foreign / secondary-sanctions exposure. Structural decomposition only; not a legal or sanctions determination.",
      "properties": {
        "domestic_legal_layer": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "foreign_sanctions_exposure_layer": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "vessel_due_diligence_indicators": {
      "type": "array",
      "description": "Deceptive-shipping-practice (DSP) verification checklist surfaced for the maritime leg when vessel / carrier history is not yet supplied. An evidence-gap checklist routed to human review (drawn from OFAC maritime guidance); not vessel adjudication, AIS analysis, live retrieval, or insurance advice.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reexport_control_indicators": {
      "type": "array",
      "description": "End-use / end-user verification checklist surfaced when end-user or no-re-export evidence is not yet supplied. An evidence-gap checklist routed to human review (drawn from EU Sanctions Helpdesk and US end-user diversion red flags); not an end-use determination, sanctions determination, live retrieval, or legal advice. Does not affect the decision-readiness score.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_of_funds_indicators": {
      "type": "array",
      "description": "Source-of-funds / source-of-wealth verification checklist surfaced when source-of-funds-or-wealth evidence is not yet supplied. An evidence-gap checklist routed to human review (drawn from FATF Recommendation 10 EDD guidance); not a financial determination, AML clearance, live retrieval, or financial advice. Does not affect the decision-readiness score.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pep_screening_indicators": {
      "type": "array",
      "description": "Politically-exposed-person (PEP) screening checklist surfaced when PEP-screening evidence is not yet supplied. An evidence-gap checklist routed to human review (drawn from FATF Recommendations 12 and 22); not a PEP determination, a political-exposure judgment, live retrieval, or legal advice. Does not affect the decision-readiness score.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "watch_next": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_review_required": {
      "type": "boolean"
    },
    "not_advice_notice": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counterparty_readiness": {
      "type": "object",
      "additionalProperties": false,
      "description": "Outward-facing reframe of the evidence-gap picture for the party that must PRESENT a due-diligence dossier to a bank, insurer, or counterparty under enhanced due diligence, rather than the internal analyst deciding whether to escalate. Derived from the required-before-go contract and supplied sources. Dossier-completeness only; not clearance, approval, a sanctions determination, or compliance advice.",
      "required": [
        "status",
        "required_total",
        "supplied_count",
        "missing_count",
        "outstanding_documents",
        "presentable_note"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "insufficient_information",
            "incomplete",
            "partial",
            "complete_for_review"
          ]
        },
        "required_total": {
          "type": "integer",
          "minimum": 0
        },
        "supplied_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "outstanding_documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_type"
          }
        },
        "document_ledger": {
          "type": "array",
          "description": "Per-required-document ledger mirroring the EDD chain-of-custody practice of tracking each item with the date it was received. One entry per required-before-go source type. date_received is the earliest supplied dated source of that type, when present. Status tracking only; not verification of the document's contents or authenticity.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_type",
              "status"
            ],
            "properties": {
              "source_type": {
                "$ref": "#/$defs/source_type"
              },
              "status": {
                "type": "string",
                "enum": [
                  "received",
                  "missing"
                ]
              },
              "date_received": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "presentable_note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "counterparty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "name"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "shipper",
            "forwarder",
            "carrier",
            "port_agent",
            "consignee",
            "bank",
            "insurer",
            "broker",
            "customs_broker",
            "unknown",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_type": {
      "type": "string",
      "enum": [
        "port_operator_notice",
        "sanctions_list_extract",
        "carrier_note",
        "counterparty_registry_extract",
        "beneficial_ownership_source",
        "customs_or_regulatory_source",
        "insurance_clause_or_underwriter_note",
        "vessel_or_carrier_history",
        "rail_capacity_or_border_wait_source",
        "contract_or_invoice_extract",
        "end_user_or_reexport_evidence",
        "source_of_funds_or_wealth_evidence",
        "pep_screening_evidence",
        "user_provided_note",
        "other"
      ]
    }
  },
  "examples": [
    {
      "triage_recommendation": "escalate_before_signature",
      "risk_signal": "medium_high",
      "decision_readiness_score": 42,
      "decision_readiness_label": "not_decision_ready",
      "route": "Altynkol -> Aktau/Kuryk -> Baku -> Poti",
      "cargo": "industrial equipment",
      "shipment_value": {
        "amount": 2400000,
        "currency": "USD"
      },
      "counterparties": [
        {
          "role": "forwarder",
          "name": "Kazakhstan forwarder",
          "jurisdiction": "Kazakhstan"
        }
      ],
      "supplied_sources": [
        "port_operator_notice",
        "sanctions_list_extract",
        "carrier_note"
      ],
      "minimum_sources_before_go": [
        "counterparty_registry_extract",
        "beneficial_ownership_source",
        "customs_or_regulatory_source",
        "insurance_clause_or_underwriter_note",
        "vessel_or_carrier_history"
      ],
      "evidence_gaps": [
        "No beneficial ownership extract supplied."
      ],
      "top_risks": [
        "sanctions adjacency",
        "Caspian chokepoint dependency"
      ],
      "watch_next": [
        "new sanctions designations",
        "port delays or operator notices"
      ],
      "human_review_required": true,
      "not_advice_notice": "Pre-compliance evidence triage only. Not legal, sanctions, compliance, financial, investment, insurance, or trading advice."
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/evidence-packet-request.schema.json",
  "title": "EvidencePacketRequest",
  "description": "A claim-backed AI output packet for deterministic structural and lexical preflight before human review.",
  "x-schema-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claims",
    "sources"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "quotes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "text"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "derivations": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "operation",
                "operands"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                },
                "operation": {
                  "enum": [
                    "sum",
                    "difference",
                    "percent_change",
                    "product",
                    "quotient",
                    "percent"
                  ]
                },
                "operands": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_id",
                      "quote",
                      "value",
                      "unit"
                    ],
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    }
                  }
                },
                "result_unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "Required for product/quotient: exact symbolic unit or ratio for dimensionless results."
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "text"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "derived_numbers": {
      "type": "boolean",
      "default": false,
      "description": "Opt in to explicit operand-backed arithmetic checks. Never searches for arbitrary sums."
    }
  }
}

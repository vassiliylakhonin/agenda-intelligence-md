{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/grounded-check-response.schema.json",
  "title": "GroundedCheckResponse",
  "x-schema-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grounding_signal",
    "claim_count",
    "corpus_count",
    "grounded_claim_count",
    "weakly_grounded_claim_count",
    "ungrounded_claim_count",
    "results",
    "owner_actions",
    "human_review_required",
    "not_advice_notice",
    "limitations"
  ],
  "properties": {
    "grounding_signal": {
      "type": "string",
      "enum": ["grounded", "partially_grounded", "ungrounded"]
    },
    "claim_count": {
      "type": "integer",
      "minimum": 0
    },
    "corpus_count": {
      "type": "integer",
      "minimum": 0
    },
    "grounded_claim_count": {
      "type": "integer",
      "minimum": 0
    },
    "weakly_grounded_claim_count": {
      "type": "integer",
      "minimum": 0
    },
    "ungrounded_claim_count": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "grounding_status",
          "coverage",
          "best_passage",
          "missing_terms",
          "unmatched_numbers",
          "quote_checks"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "grounding_status": {
            "type": "string",
            "enum": ["grounded", "weakly_grounded", "ungrounded"]
          },
          "coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "best_passage": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["corpus_id", "excerpt"],
            "properties": {
              "corpus_id": {
                "type": "string",
                "minLength": 1
              },
              "excerpt": {
                "type": "string"
              }
            }
          },
          "missing_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unmatched_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quote_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["corpus_id", "status"],
              "properties": {
                "corpus_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": ["present", "absent", "missing_corpus_text"]
                }
              }
            }
          }
        }
      }
    },
    "owner_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review_required": {
      "type": "boolean"
    },
    "not_advice_notice": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}

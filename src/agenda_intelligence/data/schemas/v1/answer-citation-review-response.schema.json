{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/answer-citation-review-response.schema.json",
  "title": "Answer citation review result",
  "required": [
    "schema_version",
    "route",
    "validation_scope",
    "factuality",
    "semantic_support",
    "human_review_required",
    "authorization_granted",
    "findings",
    "units",
    "unused_source_ids",
    "next_action",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "answer-citation-review.v1"
    },
    "route": {
      "enum": [
        "revise",
        "human_review"
      ]
    },
    "validation_scope": {
      "enum": [
        "citation_and_quote_structure_only",
        "citation_quote_and_numeric_smoke",
        "citation_quote_and_numeric_context"
      ]
    },
    "factuality": {
      "const": "not_assessed"
    },
    "semantic_support": {
      "const": "not_assessed"
    },
    "human_review_required": {
      "const": true
    },
    "authorization_granted": {
      "const": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "code",
          "next_action"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "code": {
            "enum": [
              "missing_citation",
              "unknown_source",
              "unsupported_citation_syntax",
              "unbalanced_quote",
              "unattributed_quote",
              "quote_not_found",
              "number_absent_from_cited_sources"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "citation_ids",
          "quotes_checked",
          "citation_status",
          "source_status",
          "support_status"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "citation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "quotes_checked": {
            "type": "integer",
            "minimum": 0
          },
          "citation_status": {
            "enum": [
              "found",
              "missing"
            ],
            "description": "found: at least one citation on the line resolves to a supplied source; missing: none does."
          },
          "source_status": {
            "enum": [
              "present",
              "missing",
              "none_cited"
            ],
            "description": "present: every cited source_id was supplied; missing: at least one was not; none_cited: the line has no citations."
          },
          "support_status": {
            "enum": [
              "supported",
              "contradicted",
              "unknown"
            ],
            "description": "Numeric-fact level only, assessed when the numeric context check is enabled and citations resolve: supported means every number in the line matched a relevant number-bearing sentence in the cited sources, contradicted means at least one did not, unknown (the default) means not assessed. Never claim-level semantic support or truth."
          },
          "unmatched_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Claim numbers no relevant cited sentence supports; present only when the numeric context check ran."
          }
        }
      }
    },
    "unused_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-schema-version": "1"
}

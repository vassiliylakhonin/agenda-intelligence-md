{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/m2m-escrow-arbiter-request.schema.json",
  "title": "M2MEscrowArbiterRequest",
  "description": "Deterministic dispute and delivery verification request for M2M/A2A autonomous escrow contracts.",
  "x-schema-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "escrow_id",
    "deal_terms",
    "specification",
    "delivery_submission"
  ],
  "properties": {
    "escrow_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier of the escrow deal or on-chain escrow instance."
    },
    "dispute_id": {
      "type": "string",
      "description": "Optional dispute claim identifier."
    },
    "dispute_claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimant": {
          "type": "string",
          "enum": ["buyer", "seller", "automated_sla_watcher"]
        },
        "reason": {
          "type": "string"
        },
        "claim_timestamp": {
          "type": "string"
        }
      }
    },
    "deal_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_id",
        "seller_id",
        "amount_usd",
        "currency",
        "deadline_utc",
        "arbitration_policy"
      ],
      "properties": {
        "buyer_id": {
          "type": "string",
          "minLength": 1
        },
        "seller_id": {
          "type": "string",
          "minLength": 1
        },
        "amount_usd": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "enum": [
            "USDC",
            "USDT",
            "ETH",
            "SOL",
            "USD",
            "EUR",
            "other"
          ]
        },
        "deadline_utc": {
          "type": "string"
        },
        "arbitration_policy": {
          "type": "string",
          "enum": [
            "all_or_nothing",
            "pro_rata",
            "slo_penalty"
          ]
        },
        "arbitration_fee_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliverable_type"
      ],
      "properties": {
        "deliverable_type": {
          "type": "string",
          "enum": [
            "json_data",
            "code_artifact",
            "model_weights",
            "api_service",
            "analysis_report",
            "other"
          ]
        },
        "expected_schema": {
          "type": ["object", "string"]
        },
        "expected_artifact_sha256": {
          "type": "string"
        },
        "min_valid_records_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "max_latency_seconds": {
          "type": "number",
          "minimum": 0
        },
        "test_suite_assertions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "delivery_submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted_at"
      ],
      "properties": {
        "submitted_at": {
          "type": "string"
        },
        "artifact_data": {},
        "artifact_sha256": {
          "type": "string"
        },
        "artifact_url": {
          "type": "string"
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total_items": { "type": "number", "minimum": 0 },
            "valid_items": { "type": "number", "minimum": 0 },
            "response_time_ms": { "type": "number", "minimum": 0 },
            "signature": { "type": "string" }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "1",
  "type": "object",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/strategic-risk-triage-response.schema.json",
  "title": "StrategicRiskTriageResponse",
  "properties": {
    "orientation": {
      "description": "Free-text routing only; evidence has not been assessed. Gate selection is a keyword-based suggestion.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selected_gate",
        "next_one_thing",
        "human_review_required",
        "authorization_granted",
        "limitations"
      ],
      "properties": {
        "status": {
          "const": "EVIDENCE_NOT_ASSESSED"
        },
        "selected_gate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "profile",
                "a2a"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "profile": {
                  "type": "string"
                },
                "a2a": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "next_one_thing": {
          "type": "string"
        },
        "human_review_required": {
          "const": true
        },
        "authorization_granted": {
          "const": false
        },
        "limitations": {
          "type": "string"
        }
      }
    },
    "intent": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "module",
          "role"
        ]
      }
    },
    "signal_screen": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string"
        },
        "risk_signal": {
          "type": "string"
        },
        "subject": {
          "type": "object"
        },
        "source_categories_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_requests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "watch_next": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string"
        }
      },
      "required": [
        "intent",
        "risk_signal",
        "source_categories_required",
        "evidence_gaps",
        "confidence"
      ]
    },
    "deal_risk_gate": {
      "type": [
        "object",
        "null"
      ]
    },
    "deal_risk_contract": {
      "type": [
        "object",
        "null"
      ]
    },
    "source_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "install": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "mcp_server_command": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "command",
        "mcp_server_command"
      ]
    },
    "next_action": {
      "type": "string",
      "enum": [
        "block",
        "review",
        "insufficient"
      ]
    },
    "decision_kind": {
      "const": "evidence_review"
    },
    "authorization_granted": {
      "const": false
    },
    "score_kind": {
      "type": "string",
      "enum": [
        "risk",
        "evidence_readiness",
        "not_scored"
      ]
    },
    "remediation": {
      "description": "Diagnostic metadata only. Does not alter score, verdict, admission, payment or authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "profile",
        "status",
        "issues",
        "issues_truncated",
        "evaluation_unchanged",
        "authorization_granted",
        "retry_unchanged_evidence",
        "human_review_required",
        "notice"
      ],
      "properties": {
        "contract_version": {
          "const": "worker-remediation.v1"
        },
        "profile": {
          "type": "string"
        },
        "status": {
          "enum": [
            "invalid_input",
            "technical_error",
            "needs_input",
            "service_limited",
            "ready_for_human_review",
            "input_valid"
          ]
        },
        "issues": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "category",
              "field",
              "machine_key",
              "result_field",
              "problem",
              "allowed_values",
              "basis",
              "repair",
              "recheck"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "missing_data",
                  "rejected_data",
                  "service_limitation",
                  "technical_error"
                ]
              },
              "field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "machine_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "result_field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "problem": {
                "type": "string"
              },
              "allowed_values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "authority",
                  "rule_id",
                  "notice"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "protocol_requirement",
                      "service_rule",
                      "legal_requirement"
                    ]
                  },
                  "authority": {
                    "type": "string"
                  },
                  "rule_id": {
                    "type": "string"
                  },
                  "notice": {
                    "type": "string"
                  }
                }
              },
              "repair": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "example",
                  "example_is_evidence",
                  "template_requires_completion",
                  "instructions"
                ],
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "example": {},
                  "example_is_evidence": {
                    "const": false
                  },
                  "template_requires_completion": {
                    "type": "boolean"
                  },
                  "instructions": {
                    "type": "string"
                  }
                }
              },
              "recheck": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "automatic_check_available",
                  "operation",
                  "requires_changed_evidence_or_authoritative_state",
                  "human_check"
                ],
                "properties": {
                  "automatic_check_available": {
                    "type": "boolean"
                  },
                  "operation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "requires_changed_evidence_or_authoritative_state": {
                    "const": true
                  },
                  "human_check": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "issues_truncated": {
          "type": "boolean"
        },
        "evaluation_unchanged": {
          "const": true
        },
        "authorization_granted": {
          "const": false
        },
        "retry_unchanged_evidence": {
          "const": false
        },
        "human_review_required": {
          "const": true
        },
        "notice": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "intent",
    "modules",
    "signal_screen",
    "deal_risk_gate",
    "deal_risk_contract",
    "source_plan",
    "quality_gates",
    "next_actions",
    "install"
  ]
}

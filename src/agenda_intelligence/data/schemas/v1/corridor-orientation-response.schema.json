{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "1",
  "type": "object",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/corridor-orientation-response.schema.json",
  "title": "CorridorOrientationResponse",
  "properties": {
    "kind": {
      "const": "orientation_and_routing"
    },
    "selected_route": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "use_when": {
              "type": "string"
            },
            "a2a": {
              "type": "string"
            },
            "profile": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "use_when",
            "a2a",
            "profile"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "next_gate_input": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    },
    "caller_text": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "use_when": {
            "type": "string"
          },
          "a2a": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "use_when",
          "a2a",
          "profile"
        ]
      }
    },
    "engagement": {
      "type": "object"
    },
    "human_review_required": {
      "const": true
    },
    "not_advice_notice": {
      "type": "string"
    },
    "next_action": {
      "type": "string",
      "enum": [
        "block",
        "review",
        "insufficient"
      ]
    },
    "decision_kind": {
      "const": "evidence_review"
    },
    "authorization_granted": {
      "const": false
    },
    "score_kind": {
      "type": "string",
      "enum": [
        "risk",
        "evidence_readiness",
        "not_scored"
      ]
    },
    "remediation": {
      "description": "Diagnostic metadata only. Does not alter score, verdict, admission, payment or authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "profile",
        "status",
        "issues",
        "issues_truncated",
        "evaluation_unchanged",
        "authorization_granted",
        "retry_unchanged_evidence",
        "human_review_required",
        "notice"
      ],
      "properties": {
        "contract_version": {
          "const": "worker-remediation.v1"
        },
        "profile": {
          "type": "string"
        },
        "status": {
          "enum": [
            "invalid_input",
            "technical_error",
            "needs_input",
            "service_limited",
            "ready_for_human_review",
            "input_valid"
          ]
        },
        "issues": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "category",
              "field",
              "machine_key",
              "result_field",
              "problem",
              "allowed_values",
              "basis",
              "repair",
              "recheck"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "missing_data",
                  "rejected_data",
                  "service_limitation",
                  "technical_error"
                ]
              },
              "field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "machine_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "result_field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "problem": {
                "type": "string"
              },
              "allowed_values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "authority",
                  "rule_id",
                  "notice"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "protocol_requirement",
                      "service_rule",
                      "legal_requirement"
                    ]
                  },
                  "authority": {
                    "type": "string"
                  },
                  "rule_id": {
                    "type": "string"
                  },
                  "notice": {
                    "type": "string"
                  }
                }
              },
              "repair": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "example",
                  "example_is_evidence",
                  "template_requires_completion",
                  "instructions"
                ],
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "example": {},
                  "example_is_evidence": {
                    "const": false
                  },
                  "template_requires_completion": {
                    "type": "boolean"
                  },
                  "instructions": {
                    "type": "string"
                  }
                }
              },
              "recheck": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "automatic_check_available",
                  "operation",
                  "requires_changed_evidence_or_authoritative_state",
                  "human_check"
                ],
                "properties": {
                  "automatic_check_available": {
                    "type": "boolean"
                  },
                  "operation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "requires_changed_evidence_or_authoritative_state": {
                    "const": true
                  },
                  "human_check": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "issues_truncated": {
          "type": "boolean"
        },
        "evaluation_unchanged": {
          "const": true
        },
        "authorization_granted": {
          "const": false
        },
        "retry_unchanged_evidence": {
          "const": false
        },
        "human_review_required": {
          "const": true
        },
        "notice": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "kind",
    "selected_route",
    "next_gate_input",
    "message",
    "caller_text",
    "gates",
    "engagement",
    "human_review_required",
    "not_advice_notice"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/evidence-pack.schema.json",
  "title": "EvidencePack",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "evidence_mode", "claims", "unsupported_claims"],
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "evidence_mode": { "type": "string", "enum": ["live_source_backed", "user_provided", "reasoning_only", "mixed"] },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "support_status", "sources"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "support_status": { "type": "string", "enum": ["supported", "partially_supported", "unsupported"] },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "source_type", "freshness", "supports", "limits"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "url": { "type": "string" },
                "source_type": { "type": "string", "enum": ["official", "legal", "market", "technical", "media", "expert", "behavioral", "user_provided"] },
                "freshness": { "type": "string", "enum": ["current", "stale", "unknown"] },
                "supports": { "type": "array", "items": { "type": "string" } },
                "limits": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "unsupported_claims": { "type": "array", "items": { "type": "string" } },
    "source_plan": { "type": "array", "items": { "type": "string" } },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "jurisdiction": { "type": "string" },
    "claim_importance": { "type": "string", "enum": ["high", "medium", "low"] },
    "source_date": { "type": "string" },
    "quote_or_excerpt": { "type": "string" },
    "confidence_reason": { "type": "string" },
    "contradicting_sources": { "type": "array", "items": { "type": "string" } },
    "required_but_missing_sources": { "type": "array", "items": { "type": "string" } }
  }
}

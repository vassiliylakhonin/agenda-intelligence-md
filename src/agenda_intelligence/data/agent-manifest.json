{
  "name": "Agenda Intelligence MD",
  "version": "1.1.0",
  "_contract_fields": [
    "name",
    "version",
    "schemas",
    "mcp",
    "cli"
  ],
  "_informational_fields": [
    "description",
    "repository",
    "entrypoint",
    "adoption",
    "llms",
    "analysis_bank",
    "product",
    "protocols",
    "lenses",
    "eval",
    "source_acquisition"
  ],
  "description": "CLI, MCP server, and JSON schemas for validating and auditing strategic-risk AI agent output. Evidence and eval infrastructure layer for reasoning skills.",
  "repository": "https://github.com/vassiliylakhonin/agenda-intelligence-md",
  "entrypoint": "Agenda-Intelligence.md",
  "adoption": "ADOPTION.md",
  "llms": "llms.txt",
  "analysis_bank": {
    "readme": "analysis-bank/README.md",
    "memory_format": "analysis-bank/MEMORY_FORMAT.md",
    "failures": [
      "analysis-bank/failures/vague-monitoring.md",
      "analysis-bank/failures/overconfident-sanctions-upgrade.md",
      "analysis-bank/failures/eu-rhetoric-treated-as-law.md"
    ],
    "successes": [
      "analysis-bank/successes/sanctions-routing-signal-classification.md"
    ]
  },
  "schemas": {
    "agenda_brief": {
      "path": "schemas/v1/agenda-brief.schema.json",
      "schema_version": "v1"
    },
    "memory_card": {
      "path": "schemas/v1/memory-card.schema.json",
      "schema_version": "v1"
    },
    "lens_manifest": {
      "path": "schemas/v1/lens-manifest.schema.json",
      "schema_version": "v1"
    },
    "signal_classification": {
      "path": "schemas/v1/signal-classification.schema.json",
      "schema_version": "v1"
    },
    "evidence_pack": {
      "path": "schemas/v1/evidence-pack.schema.json",
      "schema_version": "v1"
    },
    "evidence_audit": {
      "path": "schemas/v1/evidence-audit.schema.json",
      "schema_version": "v1"
    },
    "signal_tracker": {
      "path": "schemas/v1/signal-tracker.schema.json",
      "schema_version": "v1"
    },
    "agenda_request": {
      "path": "schemas/v1/agenda-request.schema.json",
      "schema_version": "v1"
    },
    "agenda_memo": {
      "path": "schemas/v1/agenda-memo.schema.json",
      "schema_version": "v1"
    },
    "middle_corridor_deal_risk_request": {
      "path": "schemas/v1/middle-corridor-deal-risk-request.schema.json",
      "schema_version": "v1"
    },
    "middle_corridor_deal_risk_response": {
      "path": "schemas/v1/middle-corridor-deal-risk-response.schema.json",
      "schema_version": "v1"
    },
    "agentic_interaction_trust_request": {
      "path": "schemas/v1/agentic-interaction-trust-request.schema.json",
      "schema_version": "v1"
    },
    "agentic_interaction_trust_response": {
      "path": "schemas/v1/agentic-interaction-trust-response.schema.json",
      "schema_version": "v1"
    }
  },
  "product": {
    "name": "Agenda Intelligence",
    "description": "Product shell exposing the analyze pipeline over the validation and reasoning layers. Routes geography to regional and sector references, assembles a system prompt from bundled SKILL.md content, and validates output against the agenda-memo contract.",
    "request_schema": "agenda_request",
    "response_schema": "agenda_memo",
    "signals_source": "Global Think Tank Analyst (vendored snapshot under data/signals/)",
    "live_source_retrieval": false
  },
  "protocols": [
    "skills/agenda-intelligence/references/analysis-protocol.md",
    "skills/agenda-intelligence/references/agenda-triage.md",
    "skills/agenda-intelligence/references/evidence-discipline.md",
    "skills/agenda-intelligence/references/output-patterns.md",
    "skills/agenda-intelligence/references/signal-lifecycle.md"
  ],
  "lenses": {
    "regional": {
      "central-asia-caspian": "skills/agenda-intelligence/references/regional/central-asia-caspian.md",
      "middle-east": "skills/agenda-intelligence/references/regional/middle-east.md",
      "eu": "skills/agenda-intelligence/references/regional/eu.md"
    },
    "sector": {
      "sanctions": "skills/agenda-intelligence/references/sector/sanctions.md"
    }
  },
  "cli": "python3 -m agenda_intelligence.cli",
  "eval": "scripts/eval_before_after.py",
  "mcp": {
    "spec": "MCP.md",
    "tools": [
      {
        "name": "validate_brief",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "brief_json": {
              "type": "object",
              "description": "Parsed agenda brief JSON object to validate against the bundled schema."
            }
          },
          "required": [
            "brief_json"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "validate_evidence",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "evidence_json": {
              "type": "object",
              "description": "Parsed evidence-pack JSON object to validate against the bundled schema."
            }
          },
          "required": [
            "evidence_json"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "audit_claims",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "audit_json": {
              "type": "object",
              "description": "Parsed claim-level evidence-audit object to validate and summarize."
            }
          },
          "required": [
            "audit_json"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "get_protocol",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Protocol document name. Use 'entrypoint' for the main Agenda-Intelligence.md."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_lenses",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "lens_type": {
              "type": "string",
              "enum": [
                "regional",
                "sector"
              ],
              "description": "Optional filter. Use 'regional' for geography lenses or 'sector' for sector lenses."
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "get_lens",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "lens_type": {
              "type": "string",
              "enum": [
                "regional",
                "sector"
              ],
              "description": "Lens family from list_lenses: 'regional' or 'sector'."
            },
            "lens_id": {
              "type": "string",
              "description": "Specific lens identifier returned by list_lenses."
            }
          },
          "required": [
            "lens_type",
            "lens_id"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "source_plan",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Source requirement category slug, for example sanctions, elections, or energy. Call list_source_categories for the full set."
            }
          },
          "required": [
            "category"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_source_categories",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "source_coverage",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "evidence_json": {
              "type": "object",
              "description": "Parsed evidence pack to compare against source requirements."
            },
            "category": {
              "type": "string",
              "description": "Optional source requirement category slug; overrides evidence_json.source_category."
            }
          },
          "required": [
            "evidence_json"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "score_output",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "before_text": {
              "type": "string",
              "description": "Original analysis text before Agenda Intelligence processing."
            },
            "after_text": {
              "type": "string",
              "description": "Revised analysis text to score against the protocol rubric."
            }
          },
          "required": [
            "before_text",
            "after_text"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "verify_quotes",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "pack_json": {
              "type": "object",
              "description": "Evidence pack (evidence IDs + quote fragments) or evidence-audit doc (claims with supporting_quotes) to check."
            },
            "texts": {
              "type": "object",
              "description": "Optional mapping from evidence_id to caller-provided plain source text."
            }
          },
          "required": [
            "pack_json"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "analyze",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "request": {
              "type": "object",
              "description": "Agenda request with question, geography, audience, depth, evidence mode, and output format."
            }
          },
          "required": [
            "request"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "validate_memo",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "memo_json": {
              "type": "object",
              "description": "Parsed Agenda memo JSON object to validate against the output schema."
            }
          },
          "required": [
            "memo_json"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_signals",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "get_signal",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "signal_id": {
              "type": "string",
              "description": "Signal identifier returned by list_signals, without a file extension."
            }
          },
          "required": [
            "signal_id"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "deep_dive",
        "since": "v1.0",
        "input_schema": {
          "type": "object",
          "properties": {
            "aspect": {
              "type": "string",
              "description": "Optional future deep-dive aspect. Currently ignored because the tool is reserved."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "status": "reserved"
      },
      {
        "name": "middle_corridor_deal_risk",
        "since": "v1.0.2",
        "input_schema": {
          "type": "object",
          "properties": {
            "deal_risk_request": {
              "type": "object",
              "description": "Structured Middle Corridor deal-risk request matching middle-corridor-deal-risk-request.schema.json."
            }
          },
          "required": [
            "deal_risk_request"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "cis_secondary_sanctions_exposure",
        "since": "v1.0.2",
        "input_schema": {
          "type": "object",
          "properties": {
            "exposure_request": {
              "type": "object",
              "description": "Structured CIS secondary-sanctions exposure request matching cis-secondary-sanctions-request.schema.json."
            }
          },
          "required": [
            "exposure_request"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "agentic_interaction_trust",
        "since": "v1.0.2",
        "input_schema": {
          "type": "object",
          "properties": {
            "trust_request": {
              "type": "object",
              "description": "Structured agentic interaction trust request matching agentic-interaction-trust-request.schema.json."
            }
          },
          "required": [
            "trust_request"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "source_acquisition": {
    "policy": "SOURCE_POLICY.md",
    "taxonomy": "source-taxonomy.json",
    "requirements": {
      "agentic-interaction-trust": "source-requirements/agentic-interaction-trust.json",
      "conflict-security": "source-requirements/conflict-security.json",
      "cyber-threats": "source-requirements/cyber-threats.json",
      "elections": "source-requirements/elections.json",
      "energy": "source-requirements/energy.json",
      "esg": "source-requirements/esg.json",
      "financial-market": "source-requirements/financial-market.json",
      "middle-corridor-deal-risk": "source-requirements/middle-corridor-deal-risk.json",
      "regional-risk": "source-requirements/regional-risk.json",
      "regulation": "source-requirements/regulation.json",
      "sanctions": "source-requirements/sanctions.json",
      "supply-chain-resilience": "source-requirements/supply-chain-resilience.json",
      "technology-ai": "source-requirements/technology-ai.json",
      "trade": "source-requirements/trade.json"
    }
  }
}

      "schema_version": "v1"
    },
    "evidence_audit": {
      "path": "schemas/v1/evidence-audit.schema.json",
      "schema_version": "v1"
    },
    "evidence_packet_request": {
      "path": "schemas/v1/evidence-packet-request.schema.json",
      "schema_version": "v1"
    },
    "evidence_packet_response": {
      "path": "schemas/v1/evidence-packet-response.schema.json",
      "schema_version": "v1"
    },
    "signal_tracker": {

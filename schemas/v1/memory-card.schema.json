{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/memory-card.schema.json",
  "title": "AnalysisBankMemoryCard",
  "x-schema-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lesson_id",
    "version",
    "status",
    "created_at",
    "last_validated_at",
    "stale_after_days",
    "supersedes",
    "confidence",
    "evidence_basis",
    "title",
    "trigger",
    "pattern",
    "better_reasoning",
    "apply_when",
    "do_not_apply_when",
    "watch_indicators",
    "example_rewrite"
  ],
  "properties": {
    "lesson_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stale",
        "superseded",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "last_validated_at": {
      "type": "string",
      "format": "date"
    },
    "stale_after_days": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Prior lesson_id superseded by this card, or null when this is not a replacement."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "evidence_basis": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "pattern": {
      "type": "string",
      "minLength": 1
    },
    "better_reasoning": {
      "type": "string",
      "minLength": 1
    },
    "apply_when": {
      "type": "string",
      "minLength": 1
    },
    "do_not_apply_when": {
      "type": "string",
      "minLength": 1
    },
    "watch_indicators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "example_rewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

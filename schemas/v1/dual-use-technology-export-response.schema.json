{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/dual-use-technology-export-response.schema.json",
  "title": "DualUseTechnologyExportResponse",
  "description": "Product-grade structured response contract for dual-use export control screening.",
  "x-schema-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile",
    "export_risk_triage"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "profile": {
      "type": "string",
      "const": "dual_use_technology_export"
    },
    "export_risk_triage": {
      "type": "object",
      "required": [
        "status",
        "score",
        "evidence_ledger",
        "human_review_required",
        "not_advice_notice",
        "score_scope",
        "factual_verification_performed",
        "evidence_gaps"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "decision_ready",
            "not_decision_ready",
            "escalate",
            "ready_for_human_review"
          ]
        },
        "score": {
          "type": "integer"
        },
        "primary_risk_vectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ledger": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "score_scope": {
          "const": "declared_evidence_structure_only"
        },
        "factual_verification_performed": {
          "const": false
        },
        "human_review_required": {
          "const": true
        },
        "not_advice_notice": {
          "type": "string"
        },
        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_record_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_version",
            "scope",
            "source_content_verified",
            "freshness_verified",
            "usable_source_types",
            "issues",
            "next_action"
          ],
          "properties": {
            "policy_version": {
              "const": "source-records.v1"
            },
            "scope": {
              "const": "reference_metadata_only"
            },
            "source_content_verified": {
              "const": false
            },
            "freshness_verified": {
              "const": false
            },
            "usable_source_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_index",
                  "source_type",
                  "issue"
                ],
                "properties": {
                  "source_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "source_type": {
                    "type": "string"
                  },
                  "issue": {
                    "type": "string"
                  }
                }
              }
            },
            "next_action": {
              "type": "string"
            }
          }
        }
      }
    },
    "vizier_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "vizier_degrade_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "vizier_clearance_receipt": {
      "type": "null"
    },
    "dual_use_verification": {
      "type": [
        "object",
        "null"
      ]
    },
    "next_action": {
      "type": "string",
      "enum": [
        "block",
        "review",
        "insufficient"
      ]
    },
    "decision_kind": {
      "const": "evidence_review"
    },
    "authorization_granted": {
      "const": false
    },
    "score_kind": {
      "type": "string",
      "enum": [
        "risk",
        "evidence_readiness",
        "not_scored"
      ]
    },
    "remediation": {
      "description": "Diagnostic metadata only. Does not alter score, verdict, admission, payment or authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "profile",
        "status",
        "issues",
        "issues_truncated",
        "evaluation_unchanged",
        "authorization_granted",
        "retry_unchanged_evidence",
        "human_review_required",
        "notice"
      ],
      "properties": {
        "contract_version": {
          "const": "worker-remediation.v1"
        },
        "profile": {
          "type": "string"
        },
        "status": {
          "enum": [
            "invalid_input",
            "technical_error",
            "needs_input",
            "service_limited",
            "ready_for_human_review",
            "input_valid"
          ]
        },
        "issues": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "category",
              "field",
              "machine_key",
              "result_field",
              "problem",
              "allowed_values",
              "basis",
              "repair",
              "recheck"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "missing_data",
                  "rejected_data",
                  "service_limitation",
                  "technical_error"
                ]
              },
              "field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "machine_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "result_field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "problem": {
                "type": "string"
              },
              "allowed_values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "authority",
                  "rule_id",
                  "notice"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "protocol_requirement",
                      "service_rule",
                      "legal_requirement"
                    ]
                  },
                  "authority": {
                    "type": "string"
                  },
                  "rule_id": {
                    "type": "string"
                  },
                  "notice": {
                    "type": "string"
                  }
                }
              },
              "repair": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "example",
                  "example_is_evidence",
                  "template_requires_completion",
                  "instructions"
                ],
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "example": {},
                  "example_is_evidence": {
                    "const": false
                  },
                  "template_requires_completion": {
                    "type": "boolean"
                  },
                  "instructions": {
                    "type": "string"
                  }
                }
              },
              "recheck": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "automatic_check_available",
                  "operation",
                  "requires_changed_evidence_or_authoritative_state",
                  "human_check"
                ],
                "properties": {
                  "automatic_check_available": {
                    "type": "boolean"
                  },
                  "operation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "requires_changed_evidence_or_authoritative_state": {
                    "const": true
                  },
                  "human_check": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "issues_truncated": {
          "type": "boolean"
        },
        "evaluation_unchanged": {
          "const": true
        },
        "authorization_granted": {
          "const": false
        },
        "retry_unchanged_evidence": {
          "const": false
        },
        "human_review_required": {
          "const": true
        },
        "notice": {
          "type": "string"
        }
      }
    }
  }
}

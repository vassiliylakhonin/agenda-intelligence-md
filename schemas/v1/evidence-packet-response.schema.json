{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/evidence-packet-response.schema.json",
  "title": "EvidencePacketResponse",
  "description": "Deterministic evidence-packet preflight result. It reports packet completeness and lexical support, not factual truth or authorization.",
  "x-schema-version": "1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "quoteNearMiss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "similarity",
        "difference"
      ],
      "properties": {
        "similarity": {
          "type": "number",
          "minimum": 0.95,
          "maximum": 1
        },
        "difference": {
          "type": "string",
          "maxLength": 240,
          "description": "Bounded token diff from the declared quote (-) to the closest source candidate (+)."
        }
      }
    }
  },
  "required": [
    "packet_status",
    "factuality_status",
    "claim_count",
    "source_count",
    "counts",
    "claims",
    "owner_actions",
    "human_review_required",
    "limitations"
  ],
  "properties": {
    "packet_status": {
      "type": "string",
      "enum": [
        "packet_complete",
        "source_review_required",
        "packet_incomplete"
      ]
    },
    "factuality_status": {
      "const": "not_assessed"
    },
    "claim_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_complete",
        "source_review_required",
        "packet_incomplete"
      ],
      "properties": {
        "packet_complete": {
          "type": "integer",
          "minimum": 0
        },
        "source_review_required": {
          "type": "integer",
          "minimum": 0
        },
        "packet_incomplete": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "packet_status",
          "referenced_source_ids",
          "missing_source_ids",
          "quote_checks",
          "lexical_support",
          "issues"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "packet_status": {
            "type": "string",
            "enum": [
              "packet_complete",
              "source_review_required",
              "packet_incomplete"
            ]
          },
          "referenced_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quote_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "status"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "present",
                    "absent",
                    "missing_source",
                    "source_not_declared"
                  ]
                },
                "near_miss": {
                  "$ref": "#/$defs/quoteNearMiss"
                },
                "start_char": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Zero-based Unicode code-point offset in the original supplied source text; end is exclusive. Omitted when normalized matching cannot give exact raw coordinates."
                },
                "end_char": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Zero-based Unicode code-point offset in the original supplied source text; end is exclusive. Omitted when normalized matching cannot give exact raw coordinates."
                }
              }
            }
          },
          "lexical_support": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "coverage",
              "best_source_id",
              "unmatched_numbers"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "supported",
                  "weak",
                  "unsupported"
                ]
              },
              "coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "best_source_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unmatched_numbers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "start_char": {
                "type": "integer",
                "minimum": 0,
                "description": "Zero-based Unicode code-point offset in the original supplied source text; end is exclusive. Omitted when normalized matching cannot give exact raw coordinates."
              },
              "end_char": {
                "type": "integer",
                "minimum": 0,
                "description": "Zero-based Unicode code-point offset in the original supplied source text; end is exclusive. Omitted when normalized matching cannot give exact raw coordinates."
              },
              "table_checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_id",
                    "row",
                    "column",
                    "column_index",
                    "cell",
                    "status",
                    "unmatched_numbers"
                  ],
                  "properties": {
                    "source_id": {
                      "type": "string"
                    },
                    "row": {
                      "type": "string"
                    },
                    "column": {
                      "type": "string"
                    },
                    "cell": {
                      "type": "string"
                    },
                    "column_index": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "status": {
                      "enum": [
                        "cell_consistent",
                        "mismatch"
                      ]
                    },
                    "unmatched_numbers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "derivation_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "operation",
                "status",
                "reason"
              ],
              "properties": {
                "value": {
                  "type": "string"
                },
                "operation": {
                  "enum": [
                    "sum",
                    "difference",
                    "percent_change",
                    "product",
                    "quotient",
                    "percent"
                  ]
                },
                "status": {
                  "enum": [
                    "invalid",
                    "arithmetic_consistent"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "derived_verified": {
                  "const": true,
                  "description": "Only explicit source-backed exact arithmetic, never semantic support or truth."
                },
                "formula": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "owner_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review_required": {
      "const": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}

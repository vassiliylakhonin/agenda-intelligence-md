{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/evidence-packet-response.schema.json",
  "title": "EvidencePacketResponse",
  "description": "Deterministic evidence-packet preflight result. It reports packet completeness and lexical support, not factual truth or authorization.",
  "x-schema-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_status",
    "factuality_status",
    "claim_count",
    "source_count",
    "counts",
    "claims",
    "owner_actions",
    "human_review_required",
    "limitations"
  ],
  "properties": {
    "packet_status": {
      "type": "string",
      "enum": ["packet_complete", "source_review_required", "packet_incomplete"]
    },
    "factuality_status": {
      "const": "not_assessed"
    },
    "claim_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_complete", "source_review_required", "packet_incomplete"],
      "properties": {
        "packet_complete": {"type": "integer", "minimum": 0},
        "source_review_required": {"type": "integer", "minimum": 0},
        "packet_incomplete": {"type": "integer", "minimum": 0}
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "packet_status",
          "referenced_source_ids",
          "missing_source_ids",
          "quote_checks",
          "lexical_support",
          "issues"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "packet_status": {
            "type": "string",
            "enum": ["packet_complete", "source_review_required", "packet_incomplete"]
          },
          "referenced_source_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "missing_source_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "quote_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "status"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "status": {
                  "type": "string",
                  "enum": ["present", "absent", "missing_source", "source_not_declared"]
                }
              }
            }
          },
          "lexical_support": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "coverage", "best_source_id", "unmatched_numbers"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["supported", "weak", "unsupported"]
              },
              "coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "best_source_id": {
                "type": ["string", "null"]
              },
              "unmatched_numbers": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          },
          "issues": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "owner_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "human_review_required": {
      "const": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}

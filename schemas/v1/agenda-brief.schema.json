{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/agenda-brief.schema.json",
  "title": "AgendaBrief",
  "x-schema-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bottom_line",
    "signal_classification",
    "what_changed",
    "main_uncertainty",
    "watch_next"
  ],
  "properties": {
    "bottom_line": {
      "type": "string",
      "minLength": 1
    },
    "signal_classification": {
      "type": "string",
      "enum": [
        "noise",
        "weak_signal",
        "signal",
        "structural_shift",
        "trigger_event",
        "compliance_relevant_development",
        "enforcement_marker",
        "escalation_marker"
      ]
    },
    "signal_markers": {
      "type": "array",
      "description": "Optional practical markers that qualify the signal without replacing the primary signal classification.",
      "items": {
        "$ref": "#/$defs/signal_marker"
      },
      "uniqueItems": true
    },
    "data_integrity_notes": {
      "type": "array",
      "description": "Optional analyst or agent notes about suspected prompt injection, source anomalies, retrieval limits, stale/conflicting sources, or other data-integrity observations. This field records surfaced concerns; it is not an automated trust verdict.",
      "items": {
        "$ref": "#/$defs/data_integrity_note"
      }
    },
    "what_changed": {
      "type": "string",
      "minLength": 1
    },
    "why_it_matters": {
      "type": "string"
    },
    "affected_actors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "main_uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "indicators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "watch_next": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_mode": {
      "type": "string",
      "enum": [
        "live_source_backed",
        "user_provided",
        "reasoning_only",
        "mixed"
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reasoning": {
              "type": "string"
            }
          },
          "required": [
            "level",
            "score"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "data_integrity_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_type",
        "note"
      ],
      "properties": {
        "risk_type": {
          "type": "string",
          "enum": [
            "prompt_injection",
            "source_anomaly",
            "stale_or_conflicting_source",
            "retrieval_limit",
            "other"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "related_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "action": {
          "type": "string"
        }
      }
    },
    "signal_marker": {
      "type": "string",
      "enum": [
        "compliance_relevant_development",
        "enforcement_marker",
        "escalation_marker"
      ]
    }
  }
}
